# =============================================================================
# free-pi-cli-proxy 環境變數設定檔 (.env)
# =============================================================================
# 使用方式：
#   1. 將此檔案複製為 .env（如果還沒有的話）
#   2. 修改其中的值以符合你的環境
#   3. 執行 bun server.mjs 啟動 proxy
#
# 注意：.env 包含敏感資訊（如 JWT），請勿提交到版本控制（git）
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 上游 free-pi.ai 設定
# ─────────────────────────────────────────────────────────────────────────────

# 上游 API Base URL，預設為 https://api.freepi.ai
# 如需使用測試環境或自訂代理，可在此覆寫
FREEPI_BASE_URL=https://api.freepi.ai

# ─────────────────────────────────────────────────────────────────────────────
# CLI 版本字串（重要：上游有 minCliVersion 強制更新閘門）
# ─────────────────────────────────────────────────────────────────────────────
# 上游 api.freepi.ai 會檢查 x-client-version 標頭，版本太低會拒絕服務
# 目前已知最低需求：0.6.2，建議設為 npm 上的最新版 0.6.14
#
# 設定方式（優先順序）：
#   1. 命令列參數：bun server.mjs --client-version 0.6.14
#   2. 環境變數/.env：FREEPI_CLIENT_VERSION=0.6.14（在此設定）
#   3. 預設值：0.4.10（若上游報 "below the required minimum"，請調高此值）
#
FREEPI_CLIENT_VERSION=0.6.14

# ─────────────────────────────────────────────────────────────────────────────
# 認證設定（三選一，取得 free-pi JWT）
# ─────────────────────────────────────────────────────────────────────────────
# Proxy 需要一個有效的 free-pi JWT 才能呼叫上游 API。
# JWT 可透過以下三種方式之任一取得：

# 方式 1：直接提供 JWT（推薦用於部署/容器/CI）
# 從 ~/.free-pi/agent/credentials.json 讀取的 token 填入此處
# 格式：FREEPI_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# FREEPI_JWT=你的_jwt_token_這裡

# 方式 1b：多帳號 JWT 輪替（避免單一帳號 hourly limit 用完）
# 設定 FREEPI_JWT_LIST 來自不同 GitHub 帳號的多個 JWT，支援逗號或換行分隔。
# 當一個帳號達到每小時限制（rate_limit_exceeded）或每日額度用完時，
# proxy 會自動切換到下一個可用帳號，無需手動干預。
# /health 端點會顯示所有帳號的狀態與剩餘額度。
#
# 單行（逗號分隔）：
# FREEPI_JWT_LIST=eyJhbGci…JWT_A,eyJhbGci…JWT_B
#
# 多行（換行分隔）：
# FREEPI_JWT_LIST=eyJhbGci…JWT_A
#                  eyJhbGci…JWT_B
#
# 優先順序：FREEPI_JWT_LIST > FREEPI_JWT > ~/.free-pi/agent/credentials.json

# 方式 2：用本專案內建登入取得（推薦，免安裝 free-pi-cli）
#   執行：bun login.mjs   （或 npm run login）
#   會走 GitHub device flow，將驗證碼顯示在終端，使用者在瀏覽器輸入後授權
#   登入成功後，JWT 會同時寫入：
#     - ~/.free-pi/agent/credentials.json
#     - .env 檔案的 FREEPI_JWT 欄位（需 FREEPI_WRITE_JWT_TO_ENV=1）
#
# 方式 3：從 free-pi-cli 的 credentials 檔讀取
#   proxy 啟動時會自動讀取 ~/.free-pi/agent/credentials.json
#   廣告廣告 session 由 proxy 自動建立（無需執行 npx free-pi-cli@latest）

# ─────────────────────────────────────────────────────────────────────────────
# 自動登入設定（僅方式 2 需要）
# ─────────────────────────────────────────────────────────────────────────────

# 讓 proxy 啟動時若找不到 JWT 就自動走 GitHub device flow 登入
# 預設 0 = 關閉；設為 1 = 開啟
# 需要互動式終端機（TTY），無法在純背景/CI 環境使用
# 登入成功後，JWT 會寫入 credentials.json 與 .env
FREEPI_AUTO_LOGIN=1

# 從 device flow 取得 JWT 後，是否自動寫入 .env 檔案
# 預設 1 = 開啟（寫入 .env，下次啟動無需再登入）
# 設為 0 = 僅寫入 credentials.json，不修改 .env
FREEPI_WRITE_JWT_TO_ENV=1

# device flow 的同意條款版本，預設 4（與 free-pi-cli 一致）
# 一般情況下無需修改
FREEPI_CONSENT_VERSION=4

# 可選：停用自動開啟瀏覽器（終端機無 GUI 環境時設為 1）
# FREEPI_NO_BROWSER=1

# 可選：停用非 TTY 環境的自動同意（設為 1 表示非 TTY 時不自動同意，會失敗）
# FREEPI_NO_AUTO_CONSENT=1

# ── Gravity 廣告設定（可選，免執行 npx free-pi-cli@latest）──────────
# proxy 會自動初始化 Gravity pixel 建立 session，讓上游知道帳號「已看廣告」
# 避免 403 "Ads aren't showing for this account" 錯誤。
# 不顯示廣告卡片，只在背景建立 Gravity session。

# Gravity 像素 ID（與 free-pi-cli 相同，不需修改）
# GRAVITY_PIXEL_ID=6cd74804-0541-4d9b-899d-d7fceb465b6f

# Gravity 儲存目錄（預設 ~/.free-pi/gravity）
# GRAVITY_STORAGE_DIR=~/.free-pi/gravity

# 可選：停用 Gravity pixel（若不需要廣告追蹤，但可能導致 403 廣告錯誤）
# GRAVITY_DISABLE_PIXEL=1

# ── Proxy 伺服器設定
# ─────────────────────────────────────────────────────────────────────────────

# 監聽埠，預設 6447（避開 opencode-free-proxy 的 6446）
PROXY_PORT=6447

# 監聽介面，預設 0.0.0.0（監聽所有網路介面）
PROXY_HOST=0.0.0.0

# API Keys 檔案路徑，預設 ./api-keys.json
# 首次啟動若不存在會自動生成兩組 key（admin、user-default）
# KEYS_FILE=./api-keys.json

# Log 等級：debug|info|warn|error|silent（預設 info；常駐建議 warn）
LOG_LEVEL=warn

# Session TTL（毫秒，預設 1800000 = 30 分鐘；0 = 每請求新 session）
# 同一 API Key + x-session-id 的對話會在 TTL 內復用相同上游 session
SESSION_TTL_MS=1800000

# ─────────────────────────────────────────────────────────────────────────────
# 429 限流重試參數
# ─────────────────────────────────────────────────────────────────────────────
# 上游若回傳 429（免費額度限流），proxy 會自動退避重試
# RETRY_429_MAX=4          # 最大重試次數（0 = 關閉重試）
# RETRY_429_BASE_MS=2000   # 基礎退避時間（毫秒）
# RETRY_429_CAP_MS=30000   # 單次退避上限（毫秒）
# 若 Retry-After 超過 5 分鐘（代表日額度用盡），會快速失敗不重試

# ─────────────────────────────────────────────────────────────────────────────
# 安全設定
# ─────────────────────────────────────────────────────────────────────────────

# Key 遮罩（stdout 導向持久 log 時建議設為 1）
# 啟動時印出的 API Key 會顯示為 fp-a1b2c3d…i9j0，避免洩漏完整金鑰
# MASK_KEYS=1

# =============================================================================
# 以上為所有可用環境變數。未設定者將使用預設值。
# =============================================================================